APP_NAME=Psystem
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=psystem
DB_USERNAME=psystem
DB_PASSWORD=psystem

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Em desenvolvimento os e-mails vão para o Mailpit (http://localhost:8025).
# Para enviar de verdade, troque pelo SMTP do provedor (ex.: Gmail com senha de app).
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="nao-responda@psystem.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# WhatsApp automático: "teste" só registra as mensagens (Configurações › WhatsApp); "evolution" ou "twilio" enviam de verdade.
WHATSAPP_MODO=teste
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número que aparece em Messaging › Try it out › Send a WhatsApp message (no Sandbox antigo: +14155238886).
TWILIO_WHATSAPP_FROM="whatsapp:+14155238886"
# Modelo de teste da Twilio "Your appointment is coming up on {{1}} at {{2}}":
TWILIO_CONTENT_SID_LEMBRETE=HXb5b62575e6e4ff6129ad7c8efe1f983e

# WhatsApp pela Evolution API (WHATSAPP_MODO=evolution). A chave é a mesma do container "evolution".
EVOLUTION_URL=http://evolution:8080
EVOLUTION_API_KEY=troque-esta-chave
EVOLUTION_INSTANCIA=psystem

VITE_APP_NAME="${APP_NAME}"
